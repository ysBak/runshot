# 값을 채운 .env 파일은 커밋하지 마세요.
DB_URL=jdbc:mysql://localhost:3306/runshot?connectionTimeZone=UTC
DB_USERNAME=runshot
DB_PASSWORD=
# openssl rand -base64 32 로 생성. 기존 JWT 키가 있다면 안전하게 재사용할 수 있습니다.
JWT_SECRET=
JWT_EXPIRATION_MS=900000
# Sites와 Spring Boot 양쪽에 같은 값을 안전하게 설정 (운영은 32자 이상)
RUNSHOT_GATEWAY_KEY=
MYSQL_ROOT_PASSWORD=
